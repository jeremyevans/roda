source 'https://rubygems.org'

if RUBY_VERSION < '2.3'
  gem 'rake', '<13'
else
  gem 'rake'
end

if RUBY_VERSION >= '3.4'
  if RUBY_ENGINE == 'jruby'
    gem 'rdoc', '< 8'
  else
    gem 'rdoc'
  end
end

if RUBY_VERSION < '2.3'
  gem 'json', '<2.6'
elsif RUBY_VERSION < '3.1' && RUBY_VERSION >= '3.0'
  gem 'json', '2.5.1'
else
  gem 'json'
end

case RUBY_VERSION[0, 3]
when '2.0'
  gem 'rack', '<1.6'
when '2.1', '2.2'
  gem 'rack', '<2'
when '2.3', '2.4'
  gem 'rack', '<2.1'
when '2.5'
  gem 'rack', '<2.2'
when '2.6'
  gem 'rack', '<3'
when '3.0'
  gem 'rack', '<3.1'
when '3.1'
  gem 'rack', '<3.2'
when '3.2'
  gem 'rack', '<3.3'
when '2.7', '4.0'
  # Test main branch of Rack for lowest and highest supported
  # Ruby version
  gem 'rack', :git => 'https://github.com/rack/rack'
else
  gem 'rack'
end

if RUBY_VERSION < '2.4'
  # Until mintest 5.12.0 is fixed
  gem 'minitest', '5.11.3'
else
  gem 'minitest'
end

if RUBY_VERSION >= '3.1'
  gem 'net-smtp'
end

if RUBY_VERSION < '2.2'
  gem "mail", '< 2.8'
else
  gem "mail"
end

gem "minitest-global_expectations"
gem "minitest-hooks"
gem "erubi"
gem "rack_csrf"
gem "tilt"
